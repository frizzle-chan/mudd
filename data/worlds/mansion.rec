%rec: SpawningPool
%key: Id
%mandatory: Id Room TagQuery
%allowed: Id Room Container TagQuery MaxCount RespawnIntervalMinutes NoDuplicates

Id: test_quest_map_pool
Room: store-room
Container: storeroom_box
TagQuery: test_quest_map_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: test_smashable_pool
Room: store-room
Container: storeroom_box
TagQuery: test_smashable_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: lounge_fridge_pool
Room: lounge
Container: lounge_fridge
TagQuery: lounge_drink
MaxCount: 6
RespawnIntervalMinutes: 15

Id: foyer_vase_pool
Room: foyer
Container: foyer_table
TagQuery: foyer_vase
MaxCount: 1
RespawnIntervalMinutes: 15

Id: library_desk_drawer_pool
Room: library
Container: library_desk
TagQuery: desk_drawer_loot
MaxCount: 2
RespawnIntervalMinutes: 30
NoDuplicates: yes

Id: gallery_wall_pool
Room: gallery
Container: gallery_wall
TagQuery: gallery_painting
MaxCount: 4
