# ----------------------------------------------------------------------------
# Skills XP test fixtures
# ----------------------------------------------------------------------------

Id: test_target_dummy
Name: Test Target Dummy
Prototype: object
Room: store-room
Rarity: common
Tags: test_target_dummy_spawn
DescriptionShort: a battered {{ e.name }}
DescriptionLong: A training dummy for testing attack destruction.
OnAttack: {{ effects.grant_xp("attack", 25) }}{{ effects.destroy() }}You smash the {{ e.name }} to pieces!

Id: test_apple
Name: Test Apple
Prototype: object
Room: store-room
Rarity: common
Tags: test_apple_spawn
DescriptionShort: a {{ e.name }}
DescriptionLong: A test apple for skills XP testing.
OnUse: {{ effects.grant_xp("vitality", 100) }}{{ effects.destroy() }}You eat the {{ e.name }}. Delicious!

# ----------------------------------------------------------------------------
# Fishing test fixtures
# ----------------------------------------------------------------------------

Id: test_fishing_pole
Name: Test Fishing Pole
Prototype: item
Room: store-room
Container: storeroom_box
Rarity: common
Tags: fishing_pole
DescriptionShort: a {{ e.name }}
DescriptionLong: A test fishing pole for fishing mechanic testing.
OnTake: {{ effects.pickup() }}You grab the {{ e.name }}.

Id: test_water_basin
Name: Test Water Basin
Prototype: furniture
Room: store-room
ContentsVisible: no
DescriptionShort: A {{ e.name }} full of murky water.
DescriptionLong: A basin of water for fishing mechanic testing.
OnFish: {% if e.contents %}{{ effects.dispense() }}TEST_FISH_RESPONSE{% else %}nothing is biting{% endif %}

Id: test_fish
Name: Test Fish
Prototype: fish
Room: store-room
Container: test_water_basin
Rarity: common
Tags: test_basin_fish
DescriptionShort: a {{ e.name }}
DescriptionLong: A test fish for fishing mechanic testing.

# ----------------------------------------------------------------------------
# Novel mechanic test fixtures
# ----------------------------------------------------------------------------

Id: test_furniture
Name: Test Table
Prototype: furniture
Room: store-room
ContentsVisible: yes
DescriptionShort: A {{ e.name }} sits here{% if e.contents %}. On it:{{ e.contents }}{% endif %}
DescriptionLong: A test table with visible contents.

Id: test_currency_pickup
Name: Test Coins
Prototype: object
Room: store-room
Container: storeroom_box
Rarity: common
Tags: test_currency_spawn
DescriptionShort: a pile of {{ e.name }}
DescriptionLong: Test coins for currency grant testing.
OnTake: {{ effects.grant_currency(100) }}{{ effects.destroy() }}{{ effects.broadcast("**" ~ user ~ "** pockets " ~ e ~ " (+¥100)") }}TEST_CURRENCY_RESPONSE - You pick up the coins. (+¥100)

Id: test_dispenser
Name: Test Dispenser
Prototype: furniture
Room: store-room
ContentsVisible: no
DescriptionShort: A {{ e.name }} stands against the wall.
DescriptionLong: A test dispenser for effects.dispense() testing.
OnUse: {% if e.contents %}{{ effects.dispense() }}{{ effects.broadcast("**" ~ user ~ "** uses the dispenser...") }}TEST_DISPENSE_RESPONSE - The dispenser whirs and drops something.{% else %}The dispenser is empty.{% endif %}

Id: test_dispenser_prize
Name: Test Dispenser Prize
Prototype: item
Room: store-room
Container: test_dispenser
Rarity: common
Tags: test_dispenser_loot
DescriptionShort: a {{ e.name }}
DescriptionLong: A test prize from the dispenser.

Id: test_wallet
Name: Test Wallet
Prototype: wallet
Room: store-room
Container: storeroom_box
DescriptionShort: a {{ e.name }}
DescriptionLong: A test wallet for balance display testing.

Id: test_beverage
Name: Test Beverage
Prototype: beverage
Room: store-room
Container: storeroom_box
Rarity: common
Tags: test_beverage_spawn
DescriptionShort: a chilled {{ e.name }}
DescriptionLong: A test beverage for prototype chain testing.

Id: test_terminal
Name: Test Terminal
Prototype: object
Room: store-room
ContentsVisible: no
DescriptionShort: A {{ e.name }} hums on the desk.
DescriptionLong: A test terminal for container focus testing.
OnOpen: {{ effects.set_focus() }}Welcome to the test terminal.{% if e.contents %} Files:{{ e.contents }}{% else %} (none){% endif %}
OnClose: {{ effects.clear_focus() }}Logging out.

Id: test_terminal_doc
Name: Test Document
Prototype: terminal_document
Room: store-room
Container: test_terminal
DescriptionLong: A test document for terminal_document prototype testing.
+ This is a multi-line description using
+ the continuation syntax.

Id: test_painting
Name: Test Painting
Prototype: painting
Room: store-room
Container: test_furniture
Tags: test_painting_spawn
Rarity: uncommon
DescriptionShort: {{ e.name }} by an unknown artist
DescriptionLong: A test painting for destroyable item testing.

Id: test_multi_tag_item
Name: Test Multi Tag
Prototype: item
Rarity: uncommon
Tags: test_loot test_currency_spawn test_painting_spawn
DescriptionShort: a {{ e.name }}
DescriptionLong: A test item with multiple tags for multi-tag query testing.

# ----------------------------------------------------------------------------
# Charge effect test fixtures
# ----------------------------------------------------------------------------

Id: test_charge_machine
Name: Test Charge Machine
Prototype: furniture
Room: store-room
ContentsVisible: no
DescriptionShort: A {{ e.name }} stands against the wall.
DescriptionLong: A test machine that charges ¥5 per use and dispenses a prize.
OnUse: {% if not e.contents %}The machine is empty.{% elif user.balance < 5 %}TEST_INSUFFICIENT_FUNDS - Not enough yen. You have {{ user.balance | money }}.{% else %}{{ effects.charge(5) }}{{ effects.dispense() }}{{ effects.broadcast("**" ~ user ~ "** uses the charge machine...") }}TEST_CHARGE_RESPONSE - You insert ¥5 and receive a prize!{% endif %}

Id: test_charge_prize
Name: Test Charge Prize
Prototype: item
Room: store-room
Container: test_charge_machine
Rarity: common
Tags: test_charge_prize_spawn
DescriptionShort: a {{ e.name }}
DescriptionLong: A test prize from the charge machine.

# ============================================================================
# Spawning Pool record type
# ============================================================================
%rec: SpawningPool
%key: Id
%mandatory: Id Room TagQuery
%allowed: Id Room Container TagQuery MaxCount RespawnIntervalMinutes NoDuplicates

Id: test_quest_map_pool
Room: store-room
Container: storeroom_box
TagQuery: test_quest_map_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: test_smashable_pool
Room: store-room
Container: storeroom_box
TagQuery: test_smashable_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: test_no_dup_pool
Room: store-room
Container: test_furniture
TagQuery: test_painting_spawn
MaxCount: 2
RespawnIntervalMinutes: 1
NoDuplicates: yes

Id: test_target_dummy_pool
Room: store-room
TagQuery: test_target_dummy_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: test_apple_pool
Room: store-room
TagQuery: test_apple_spawn
MaxCount: 1
RespawnIntervalMinutes: 1

Id: test_basin_fish_pool
Room: store-room
Container: test_water_basin
TagQuery: test_basin_fish
MaxCount: 1
RespawnIntervalMinutes: 1
